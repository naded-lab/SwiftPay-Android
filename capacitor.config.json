{
  "appId": "com.nadidstudio.swiftpay",
  "appName": "SwiftPay",
  "webDir": "www",
  "backgroundColor": "#0D0F11",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#0D0F11",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
